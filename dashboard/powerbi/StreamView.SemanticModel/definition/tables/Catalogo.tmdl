	partition Catalogo = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "catalogo_unificado.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Columnas = Table.SelectColumns(Encabezados, {"content_id", "tipo", "titulo", "anio_estreno", "periodo", "genero_principal", "generos", "pais_principal", "coproduccion", "idioma", "idioma_codigo", "idioma_grupo", "director", "popularidad", "popularidad_percentil", "votos", "valoracion_confiable", "valoracion_valida", "segmento", "segmento_orden", "ranking_popularidad_tipo", "presupuesto_usd", "ingresos_usd", "datos_financieros", "roi", "resultado_financiero", "rango_presupuesto", "rango_orden"}),
				    VaciosANulos = Table.ReplaceValue(Columnas, "", null, Replacer.ReplaceValue, {"anio_estreno", "popularidad", "popularidad_percentil", "votos", "valoracion_valida", "segmento_orden", "ranking_popularidad_tipo", "presupuesto_usd", "ingresos_usd", "roi", "rango_orden"}),
				    Tipos = Table.TransformColumnTypes(VaciosANulos, {{"content_id", type text}, {"tipo", type text}, {"titulo", type text}, {"anio_estreno", Int64.Type}, {"periodo", type text}, {"genero_principal", type text}, {"generos", type text}, {"pais_principal", type text}, {"coproduccion", type text}, {"idioma", type text}, {"idioma_codigo", type text}, {"idioma_grupo", type text}, {"director", type text}, {"popularidad", type number}, {"popularidad_percentil", type number}, {"votos", Int64.Type}, {"valoracion_confiable", type text}, {"valoracion_valida", type number}, {"segmento", type text}, {"segmento_orden", Int64.Type}, {"ranking_popularidad_tipo", Int64.Type}, {"presupuesto_usd", type number}, {"ingresos_usd", type number}, {"datos_financieros", type text}, {"roi", type number}, {"resultado_financiero", type text}, {"rango_presupuesto", type text}, {"rango_orden", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
