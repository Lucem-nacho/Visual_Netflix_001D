table Catalogo
	lineageTag: f6b55942-3297-4669-8e5a-1c340b24c680

	/// Contenidos únicos (una fila por content_id)
	measure Contenidos = COUNTROWS(Catalogo)
		formatString: #,0
		displayFolder: Catálogo
		lineageTag: 44b4774a-88db-4b12-81c5-9e4e8e6bc16c

	measure 'Películas' = CALCULATE(COUNTROWS(Catalogo), Catalogo[tipo] = "Película")
		formatString: #,0
		displayFolder: Catálogo
		lineageTag: 1d9fb2f3-1bc2-4c7c-9866-052d6742e95a

	measure Series = CALCULATE(COUNTROWS(Catalogo), Catalogo[tipo] = "Serie")
		formatString: #,0
		displayFolder: Catálogo
		lineageTag: 1f5f9883-518e-4d54-8633-3c153ba604c3

	measure Idiomas = DISTINCTCOUNT(Catalogo[idioma_codigo])
		formatString: #,0
		displayFolder: Catálogo
		lineageTag: 369ee839-54b7-4d62-99bb-7737ea41593d

	/// Participación de cada grupo de idioma dentro de su tipo de contenido
	measure '% del tipo' = DIVIDE([Contenidos], CALCULATE([Contenidos], REMOVEFILTERS(Catalogo[idioma_grupo])))
		formatString: 0.0%
		displayFolder: Catálogo
		lineageTag: aa5347d4-9449-46e0-8888-d42b669dfd18

	/// Promedio de vote_average solo para contenidos con al menos 10 votos
	measure 'Valoración promedio' = AVERAGE(Catalogo[valoracion_valida])
		formatString: 0.00
		displayFolder: Valoración
		lineageTag: 362feb29-23e2-4ee7-a9e2-89357ac40263

	measure 'Contenidos con valoración confiable' = CALCULATE(COUNTROWS(Catalogo), Catalogo[valoracion_confiable] = "Sí")
		formatString: #,0
		displayFolder: Valoración
		lineageTag: dd8845cb-a30e-4c3f-8790-70ac50499bf8

	measure '% valoración confiable' = DIVIDE([Contenidos con valoración confiable], [Contenidos])
		formatString: 0.0%
		displayFolder: Valoración
		lineageTag: 18bec458-4684-48d3-b85f-4dc5735928ef

	measure Estrellas = CALCULATE(COUNTROWS(Catalogo), Catalogo[segmento] = "Estrella")
		formatString: #,0
		displayFolder: Segmentos
		lineageTag: 58c1587e-df5e-42fc-ad47-2ba8624694d9

	measure 'Joyas ocultas' = CALCULATE(COUNTROWS(Catalogo), Catalogo[segmento] = "Joya oculta")
		formatString: #,0
		displayFolder: Segmentos
		lineageTag: 1823056a-509e-4c69-97f0-a97f0527147c

	measure 'Joyas con 100+ votos' = CALCULATE(COUNTROWS(Catalogo), Catalogo[segmento] = "Joya oculta", Catalogo[votos] >= 100)
		formatString: #,0
		displayFolder: Segmentos
		lineageTag: f758f6b7-1a26-4354-bd16-b776505621e1

	measure '% joyas ocultas' = DIVIDE([Joyas ocultas], [Contenidos])
		formatString: 0.0%
		displayFolder: Segmentos
		lineageTag: 09ecdac9-cd41-410d-92e9-658a193a1dd3

	measure 'Joyas sobre bien valorados' = DIVIDE([Joyas ocultas], [Joyas ocultas] + [Estrellas])
		formatString: 0.0%
		displayFolder: Segmentos
		lineageTag: f1d82954-78ce-410f-881a-1b548cc70219

	measure 'Percentil de popularidad' = AVERAGE(Catalogo[popularidad_percentil])
		formatString: 0.0
		displayFolder: Popularidad
		lineageTag: f5646dcb-3746-431c-b9d0-a9ff81e0dd12

	measure 'Percentil de popularidad mediano' = MEDIAN(Catalogo[popularidad_percentil])
		formatString: 0.0
		displayFolder: Popularidad
		lineageTag: e9c4cfeb-36e7-445c-89dc-fff02eea0a89

	measure 'Películas con datos financieros' = CALCULATE(COUNTROWS(Catalogo), Catalogo[datos_financieros] = "Sí")
		formatString: #,0
		displayFolder: Finanzas
		lineageTag: 678480ad-eea4-4600-84eb-52ac61b5c8b5

	measure 'Cobertura financiera' = DIVIDE([Películas con datos financieros], [Películas])
		formatString: 0.0%
		displayFolder: Finanzas
		lineageTag: 4a913cbe-5808-43f3-93bd-b58fb56717e0

	measure 'Presupuesto promedio (US$ M)' = DIVIDE(CALCULATE(AVERAGE(Catalogo[presupuesto_usd]), Catalogo[datos_financieros] = "Sí"), 1000000)
		formatString: 0.0
		displayFolder: Finanzas
		lineageTag: abfecfc4-4759-43c8-a165-062c66b94b84

	measure 'Ingresos promedio (US$ M)' = DIVIDE(CALCULATE(AVERAGE(Catalogo[ingresos_usd]), Catalogo[datos_financieros] = "Sí"), 1000000)
		formatString: 0.0
		displayFolder: Finanzas
		lineageTag: 2c643e17-55db-40b2-a8ee-36e16d8e52ec

	/// Presupuesto en millones, solo películas con ROI calculable e ingresos de al menos US$10 mil
	measure 'Presupuesto (US$ M)' = DIVIDE(CALCULATE(AVERAGE(Catalogo[presupuesto_usd]), Catalogo[presupuesto_usd] >= 1000000, Catalogo[ingresos_usd] >= 10000), 1000000)
		formatString: #,0.###
		displayFolder: Finanzas
		lineageTag: a66b174b-f92f-4a09-9a42-f2728e74e955

	measure 'Ingresos (US$ M)' = DIVIDE(CALCULATE(AVERAGE(Catalogo[ingresos_usd]), Catalogo[presupuesto_usd] >= 1000000, Catalogo[ingresos_usd] >= 10000), 1000000)
		formatString: #,0.###
		displayFolder: Finanzas
		lineageTag: bc4e1bab-dca3-447e-b06b-f131e7cc714b

	/// Mediana de ingresos / presupuesto, presupuesto >= US$1 M
	measure 'ROI mediano' = MEDIAN(Catalogo[roi])
		formatString: 0.00
		displayFolder: Finanzas
		lineageTag: 5200a84a-2592-43e8-9b09-bdf8b3e632d0

	measure 'Películas con ROI' = CALCULATE(COUNTROWS(Catalogo), NOT ISBLANK(Catalogo[roi]))
		formatString: #,0
		displayFolder: Finanzas
		lineageTag: c148d3a8-eaeb-4617-8fa1-87617fa07628

	measure '% recupera inversión' = DIVIDE(CALCULATE(COUNTROWS(Catalogo), Catalogo[roi] >= 1), [Películas con ROI])
		formatString: 0.0%
		displayFolder: Finanzas
		lineageTag: c5b41499-afe4-47b3-8f43-d7e1c6444377

