	partition Decisiones = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "decisiones_integracion.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Columnas = Table.SelectColumns(Encabezados, {"orden", "tema", "hallazgo", "decision"}),
				    VaciosANulos = Table.ReplaceValue(Columnas, "", null, Replacer.ReplaceValue, {"orden"}),
				    Tipos = Table.TransformColumnTypes(VaciosANulos, {{"orden", Int64.Type}, {"tema", type text}, {"hallazgo", type text}, {"decision", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

